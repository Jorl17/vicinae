// C++ process (client) -> extension manager (server)
// The C++ process requests the extension manager to load/unload extensions, and receives
// a notification each time an extension requests/notifies something.
// At this layer, the manager is unaware what the payload is made of.
// The payload is in reality another rpc message belonging to the vicinae<->extension spec.

enum CommandMode {
  View,
  NoView
};

enum CommandEnv {
  Development,
  Production
};

enum LaunchType {
  User,
  Background,
  CommandLine
};

struct Capabilities {
  browserExtension: bool;
  windowManagement: bool;
  wallpaper: bool;
  fileSearch: bool;
};

struct LoadOptions {
  mode: CommandMode;
  env: CommandEnv;
  vicinae_path: string;
  entrypoint: string;
  is_raycast: bool;
  command_name: string;
  extension_id: string;
  extension_name: string;
  owner_or_author_name: string;
  arguments: any;
  preferences: any;
  launch_context: any;
  launch_type: LaunchType;
  capabilities: Capabilities;
  fallbackText?: string;
  cwd?: string;
};

// A row that a command returns for a keyword query in the root search, for
// example "calc 2*3". The first action is the primary action.
enum KeywordActionType {
  Copy,
  Paste,
  Run
};

struct KeywordAction {
  type: KeywordActionType;
  // The text to copy or paste, or the id of a Run action for runKeywordAction.
  content: string;
  title?: string;
};

struct KeywordItem {
  title: string;
  subtitle?: string;
  icon?: string;
  accessory?: string;
  actions: KeywordAction[];
};

// We wrap the rows in a struct, because figura does not generate list return types
// for TypeScript.
struct KeywordRows {
  items: KeywordItem[];
};

// The text of the HUD that we show after a Run action, or the error message.
struct KeywordActionResult {
  hud?: string;
  error?: string;
};

struct LoadResponse {
  session_id: string;
};

service Manager {
  fn load(opts: LoadOptions) => LoadResponse;
  fn unload(session_id: string) => bool;

  // C++ side signals to extension manager that its ready to process messages from said extension
  // Happens right after the C++ side gets the session id from `load` and stores it.
  // It is important to synchronize this way otherwise we can theoretically miss the first messages if the
  // extension loads too fast.
  fn ready(session_id: string) => bool;

  fn messageExtension(session_id: string, payload: string) => bool;

  // Run the keyword handler of a command (opts.entrypoint) with the text typed
  // after the keyword. A newer query for the same command cancels the older one,
  // which then returns no rows.
  fn queryKeyword(opts: LoadOptions, query: string) => KeywordRows;

  // Run an action of type Run from the rows of the last keyword query of the command.
  fn runKeywordAction(opts: LoadOptions, action_id: string) => KeywordActionResult;

  event extensionMessage(session_id: string, payload: string);
  event extensionCrash(session_id: string, reason: string);
}
