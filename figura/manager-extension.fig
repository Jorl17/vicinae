// manager (client) to extension (server)
// the worker is already provisioned but waiting for the manager to initialize it with extension info (to avoid cold starts)

enum CommandMode {
  View,
  NoView
};

enum CommandEnv {
  Development,
  Production
};

enum LaunchType {
  User,
  Background,
  CommandLine
};

struct Capabilities {
  browserExtension: bool;
  windowManagement: bool;
  wallpaper: bool;
  fileSearch: bool;
};

struct LaunchEventData {
  extension_name: string;
  command_name: string;
  mode: CommandMode;
  entrypoint: string;
  asset_path: string;
  support_path: string;
  preferenceValues: any;
  argumentValues: any;
  launch_context: any;
  is_raycast: bool;
  owner_or_author_name: string;
  launch_type: LaunchType;
  capabilities: Capabilities;
  fallbackText?: string;
  cwd?: string;
};

// A row that a command returns for a keyword query in the root search, for
// example "calc 2*3". The first action is the primary action.
enum KeywordActionType {
  Copy,
  Paste,
  Run
};

struct KeywordAction {
  type: KeywordActionType;
  // The text to copy or paste, or the id of a Run action for runKeywordAction.
  content: string;
  title?: string;
};

struct KeywordItem {
  title: string;
  subtitle?: string;
  icon?: string;
  accessory?: string;
  actions: KeywordAction[];
};

// We wrap the rows in a struct, because figura does not generate list return types
// for TypeScript. When the handler fails, error says why and there are no rows.
struct KeywordRows {
  items: KeywordItem[];
  error?: string;
};

// The text of the HUD that we show after a Run action, or the error message.
struct KeywordActionResult {
  hud?: string;
  error?: string;
};

service Lifecycle {
  fn launch(data: LaunchEventData) => bool;
  fn shutdown() => bool;
  fn send_message(msg: string) => bool;
  fn query_keyword(data: LaunchEventData, query: string) => KeywordRows;
  fn run_keyword_action(action_id: string) => KeywordActionResult;
  event extension_message(msg: string);
  
  // worker can explicitly request to be unloaded. only applies to `no-view` commands which have a predictable termination point.
  event unload_requested();
}
